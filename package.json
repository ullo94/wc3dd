{
  "name": "wc3dd",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @wc3dd/db generate",
    "db:migrate": "pnpm --filter @wc3dd/db migrate",
    "db:seed": "pnpm --filter @wc3dd/db seed",
    "db:studio": "pnpm --filter @wc3dd/db studio",
    "web": "pnpm --filter @wc3dd/web dev",
    "bot": "pnpm --filter @wc3dd/bot dev"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
