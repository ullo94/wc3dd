# --- Database ---
POSTGRES_USER=wc3dd
POSTGRES_PASSWORD=wc3dd
POSTGRES_DB=wc3dd
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wc3dd:wc3dd@localhost:5432/wc3dd

# --- Portable storage (default ./data relative to monorepo root) ---
DATA_DIR=./data

# --- Web (Next.js on port 3000) ---
WEB_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string

# Discord OAuth app (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs treated as admins
ADMIN_DISCORD_IDS=

# Public Discord invite shown on the site
DISCORD_INVITE_URL=https://discord.gg/your-invite

# --- Bot (discord.js) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PARTICIPANT_ROLE_ID=
DISCORD_APPROVAL_CHANNEL_ID=

# Poll interval for DiscordAction queue (ms)
BOT_POLL_INTERVAL_MS=5000
